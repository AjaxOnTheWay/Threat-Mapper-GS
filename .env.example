# ThreatMapper Configuration

# Database (PostgreSQL or local SQLite fallback)
DATABASE_URL=sqlite:///./threat_mapper.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/threatmapper

# OSINT Threat Intelligence API Keys
VIRUSTOTAL_API_KEY=your_vt_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# JWT Authentication & Multi-Tenancy Security
JWT_SECRET_KEY=threatmapper_super_secure_jwt_secret_key_2026_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
